@model IEnumerable<CardGameP.Models.Cliente>

@{
    ViewBag.Title = "Gerenciar Clientes";
}

<div class="container mt-4">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 style="color:#D4AF37;">Gerenciar Clientes</h1>
            <p>Gerencie os clientes cadastrados no sistema</p>
        </div>

        <div class="d-flex gap-2">

            <!-- Botão Voltar -->
            <button onclick="history.back()" class="btn btn-outline-warning">
                ← Voltar
            </button>

            <!-- Botão Novo Cliente -->
            <a href="@Url.Action("Create", "Cliente")"
               class="btn btn-gold">
                Novo Cliente
            </a>
        </div>
    </div>

    <hr style="border-color: #555;" />

    <!-- Busca -->
    <div class="product-card mb-4 p-3"
         style="min-height:auto !important;
                height:auto !important;
                overflow:hidden;">

        <h5 class="mb-3" style="color:#D4AF37;">
            Buscar cliente
        </h5>

        @using (Html.BeginForm("AdminIndex", "Cliente", FormMethod.Get))
        {
            <div class="d-flex align-items-center gap-3">

                <input type="text"
                       name="busca"
                       class="form-control search-input search-small"
                       placeholder="Buscar por nome ou email..." />

                <button type="submit"
                        class="btn btn-gold btn-small">
                    Buscar
                </button>
            </div>
        }
    </div>

    <!-- Lista de Clientes -->
    <div class="product-card p-4">

        <h2 class="mb-3" style="color:#D4AF37;">
            Lista de Clientes
        </h2>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-dark table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Telefone</th>
                            <th>Cadastro</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    #@item.IdCliente
                                </td>

                                <td>
                                    @item.Nome
                                </td>

                                <td>
                                    @item.Email
                                </td>

                                <td>
                                    @item.Telefone
                                </td>

                                <td>
                                    @item.DataCadastro.ToShortDateString()
                                </td>

                                <td>
                                    <a href="@Url.Action("Edit", "Cliente",
                                       new { id = item.IdCliente })"
                                       class="btn btn-warning btn-sm me-1">
                                        Editar
                                    </a>

                                    <a href="@Url.Action("Details", "Cliente",
                                       new { id = item.IdCliente })"
                                       class="btn btn-info btn-sm me-1">
                                        Detalhes
                                    </a>

                                    <a href="@Url.Action("Delete", "Cliente",
                                       new { id = item.IdCliente })"
                                       class="btn btn-danger btn-sm">
                                        Excluir
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        }
        else
        {
            <div class="alert alert-dark text-center border-secondary">
                Nenhum cliente cadastrado no sistema.
            </div>
        }

    </div>
</div>