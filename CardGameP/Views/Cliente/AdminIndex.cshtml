@model List<CardGameP.Models.Cliente>

@{
    ViewBag.Title = "Gerenciar Clientes";
}

<div class="container mt-4">
    <h1 style="color:#D4AF37;">Gerenciar Clientes</h1>
    <p>Visualize os clientes cadastrados no sistema</p>
    <hr style="border-color: #555;" />

    <div class="product-card mb-4 p-3" style="min-height: auto !important; height: auto !important; overflow: hidden;">
        <h5 class="mb-3" style="color:#D4AF37;">Buscar cliente</h5>

        @using (Html.BeginForm("AdminIndex", "Cliente", FormMethod.Get))
        {
            <div class="d-flex align-items-center gap-3" style="margin-bottom: 0 !important;">
                <input type="text" name="busca" class="form-control search-input"
                       placeholder="Buscar por nome ou email..." />

                <button type="submit" class="btn btn-gold px-4">Buscar</button>
            </div>
        }
    </div>

    <div class="product-card p-4">
        <h2 class="mb-3" style="color:#D4AF37;">Lista de Clientes</h2>

        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Email</th>
                        <th>Telefone</th>
                        <th>Data Cadastro</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Nome</td>
                            <td>@item.Email</td>
                            <td>@item.Telefone</td>
                            <td>@item.DataCadastro.ToShortDateString()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>